# Tipo do banco: mysql | postgres
DB_DRIVER=mysql

# Conexão
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=

# Postgres only (ignorado em MySQL)
DB_SCHEMA=public
DB_SSLMODE=disable

# Execução (opcional — flags têm precedência)
WORKERS=6
BATCH_SIZE=3000
TABLE_CONCURRENCY=1
OUTPUT_DIR=
DEST_SUFFIX=_bkp

# Logging
LOG_LEVEL=info
LOG_FORMAT=text
